listen:
  host: 0.0.0.0
  port: 8080

poll_interval_seconds: 20
request_timeout_seconds: 5

snmp:
  enabled: true
  community: public
  port: 161
  timeout: 1.5
  retries: 0

http:
  enabled: true
  verify_tls: false

ipp:
  enabled: true

alerts:
  nongenuine_toner_as_warning: true

printers:
  - name: office-xerox
    ip: 192.168.1.10
    brand: xerox
    location: Office

  - name: ward-brother
    ip: 192.168.1.11
    brand: brother
    location: Ward
    # community: public

  - name: desk-epson
    ip: 192.168.1.12
    brand: epson
    location: Reception
